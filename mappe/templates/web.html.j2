{% macro ph(pid, ratio, sizes='(min-width: 900px) 50vw, 100vw', eager=false) %}
{% set m = photos[pid] %}
<figure class="ph">
  <button class="ph-b" type="button" data-full="img/{{ pid }}.jpg" data-n="{{ m.n|pad }}" data-cap="{{ m.caption }}" aria-label="Open photo {{ m.n }} of {{ total }}" style="aspect-ratio:{{ ratio }}">
    <img src="img/{{ pid }}-s.jpg" srcset="img/{{ pid }}-s.jpg 840w, img/{{ pid }}.jpg 1700w" sizes="{{ sizes }}" alt="{{ m.alt or (full_name ~ ', photo ' ~ m.n) }}"{% if not eager %} loading="lazy"{% endif %} decoding="async" style="object-position:{{ m.pos }}">
  </button>
  <figcaption class="lab"><span class="n">{{ m.n|pad }}</span>{% if m.caption %}<span>{{ m.caption }}</span>{% endif %}</figcaption>
</figure>
{% endmacro %}
<title>{{ full_name }} Portfolio</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=League+Gothic&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=DM+Mono:wght@400;500&display=swap">
<style>
/* Layout: a magazine issue. A two-tone masthead straddles the cover photo, spreads alternate between
   a strict grid and off-grid pairs, the digitals sit on a black contact-sheet band, measurements read as a comp card. */
:root{
  --paper:#F3F3F0; --ink:#111110; --mute:#66665F; --rule:#D3D3CC; --accent:#1F3BFF;
  --band:#0D0D0E; --band-ink:#EFEFEA; --band-mute:#8E8E87; --band-rule:#2A2A29; --on-photo:#FFFFFF;
  --display:'League Gothic','Sofia Sans Extra Condensed','Arial Narrow',Impact,sans-serif;
  --serif:'Bodoni Moda','Didot','Bodoni MT',Georgia,serif;
  --mono:'DM Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
  --gap:clamp(12px,2vw,28px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --paper:#0F0F10; --ink:#EFEFEA; --mute:#9A9A93; --rule:#2C2C2B; --accent:#8496FF;
    --band:#000000; --band-ink:#EFEFEA; --band-mute:#8E8E87; --band-rule:#2A2A29; --on-photo:#FFFFFF; color-scheme:dark }
}
:root[data-theme="dark"]{ --paper:#0F0F10; --ink:#EFEFEA; --mute:#9A9A93; --rule:#2C2C2B; --accent:#8496FF;
  --band:#000000; --band-ink:#EFEFEA; --band-mute:#8E8E87; --band-rule:#2A2A29; --on-photo:#FFFFFF; color-scheme:dark }

*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--mono);font-size:13px;line-height:1.55;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
h1,h2,p,figure,dl,dd{margin:0}
a{color:inherit;text-underline-offset:.25em}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.wrap{max-width:1480px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.lab{font-family:var(--mono);font-size:11px;line-height:1.4;letter-spacing:.14em;text-transform:uppercase}
.kick{color:var(--accent)}

.preview{background:var(--accent);color:#fff;text-align:center;padding:8px max(16px,env(safe-area-inset-right,0px)) 8px max(16px,env(safe-area-inset-left,0px))}
/* top line */
.top{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding-block:14px}
.top nav{display:none;gap:clamp(14px,2vw,30px)}
.top nav a{text-decoration:none}
.top nav a:hover{color:var(--accent)}
@media (min-width:860px){.top nav{display:flex}}

/* cover: every length is a share of the cover's own width, so the two masthead copies stay in register */
.cover{container-type:inline-size;position:relative;overflow:hidden}
.stage{position:relative;--em:{{ '%.3f'|format(mast_em) }};
  --fs:min(calc(92cqw / var(--em)),31cqw);--ix:12cqw;--iy:0cqw;--iw:88cqw;--ih:110cqw;--mx:4cqw;
  --my:calc(var(--iy) + var(--ih) - 1.38 * var(--fs));height:calc(var(--my) + 1.88 * var(--fs) + 6cqw)}
.mast{position:absolute;left:var(--mx);top:var(--my);width:max-content;font-family:var(--display);font-weight:400;font-size:var(--fs);line-height:.94;text-transform:uppercase;white-space:nowrap;letter-spacing:0}
.mast span{display:block;width:max-content}
.cover-img{position:absolute;left:var(--ix);top:var(--iy);width:var(--iw);height:var(--ih);overflow:hidden;background:var(--rule)}
.cover-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cover-img::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.5),rgba(0,0,0,0) 46%)}
.cover-img .mast{left:calc(var(--mx) - var(--ix));top:calc(var(--my) - var(--iy));color:var(--on-photo);z-index:1}
.cover-img .cut{z-index:2}
.spine{position:absolute;left:calc(var(--ix) / 2);top:3cqw;transform:translateX(-50%) rotate(180deg);writing-mode:vertical-rl;display:flex;gap:1.2em;white-space:nowrap;font-size:10px;letter-spacing:.12em}
.spine b{font-weight:400;color:var(--accent)}
@container (min-width:860px){
  .stage{--fs:min(calc(72cqw / var(--em)),23cqw);--iw:37cqw;--ih:46.25cqw;--ix:57cqw;--iy:0cqw;--mx:3cqw;
    --my:calc((var(--ih) - 1.88 * var(--fs)) / 2 + 1.2cqw);height:calc(var(--ih) + 1cqw)}
  .cover-img::after{background:linear-gradient(to right,rgba(0,0,0,.38),rgba(0,0,0,0) 62%)}
  .spine{left:auto;right:1.6cqw;top:1.2cqw;transform:rotate(180deg)}
}
@media (prefers-reduced-motion:no-preference){
  .mast span{animation:rise .9s cubic-bezier(.2,.7,.1,1) both}
  .mast span:nth-child(2){animation-delay:.08s}
  @keyframes rise{from{transform:translateY(.18em)}to{transform:none}}
}

/* intro */
.intro{display:grid;grid-template-columns:repeat(12,1fr);column-gap:var(--gap);row-gap:28px;padding-block:clamp(40px,7vw,110px);align-items:end}
.intro .say{grid-column:1/-1;font-family:var(--serif);font-style:italic;font-size:clamp(40px,7.4vw,112px);line-height:.98;letter-spacing:-.01em;text-wrap:balance}
.intro .bio{grid-column:1/-1;font-family:var(--serif);font-size:clamp(17px,1.5vw,21px);line-height:1.45;max-width:34em}
.quick{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px 22px;padding-top:14px;border-top:1px solid var(--ink)}
.quick span b{font-weight:400;color:var(--mute);margin-right:.6em}
.intro .ph{grid-column:5/-1}
@media (min-width:860px){
  .intro .say{grid-column:1/9;grid-row:1}
  .intro .ph{grid-column:10/13;grid-row:1/3}
  .intro .bio{grid-column:1/6;grid-row:2}
  .quick{grid-column:1/9;grid-row:3}
}

/* photos */
.ph{min-width:0}
.ph-b{display:block;width:100%;max-width:100%;padding:0;border:0;border-radius:0;background:var(--rule);overflow:hidden;cursor:zoom-in}
.ph-b img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.1,1)}
@media (hover:hover) and (prefers-reduced-motion:no-preference){.ph-b:hover img{transform:scale(1.025)}}
.ph figcaption{display:flex;gap:1em;padding-top:8px;color:var(--mute)}
.ph figcaption .n{color:var(--ink)}

/* stories */
.story{padding-block:clamp(36px,6vw,96px)}
.story-h{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:10px var(--gap);border-top:1px solid var(--ink);padding-top:14px}
.story-h .kick{flex-basis:100%}
.title{font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(46px,13.2vw,190px);line-height:.9;letter-spacing:-.02em;padding-bottom:.08em;min-width:0;max-width:100%}
.deck{font-family:var(--serif);font-size:clamp(16px,1.4vw,20px);line-height:1.4;max-width:24em;color:var(--mute)}
@media (min-width:860px){.story-h .deck{text-align:right;padding-bottom:1.2em;margin-left:auto}}
.row{display:grid;grid-template-columns:repeat(12,1fr);column-gap:var(--gap);row-gap:var(--gap);margin-top:clamp(26px,5vw,76px);align-items:start}
.trio>.ph:nth-child(1){grid-column:1/-1}
.trio>.ph:nth-child(2){grid-column:1/7}
.trio>.ph:nth-child(3){grid-column:7/13}
.duo>.ph:nth-child(1){grid-column:1/10}
.duo>.ph:nth-child(2){grid-column:4/13}
.lead>.ph{grid-column:1/-1}
.lead>.note{grid-column:1/-1}
.note{font-family:var(--serif);font-style:italic;font-size:clamp(22px,2.6vw,38px);line-height:1.12;text-wrap:balance}
.strip>.ph{grid-column:span 6}
.strip.odd>.ph:first-child{grid-column:1/-1}
.bleed{margin-top:clamp(26px,5vw,76px)}
.bleed .ph figcaption{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media (min-width:860px){
  .trio>.ph:nth-child(1){grid-column:1/8;grid-row:1/3}
  .trio>.ph:nth-child(2){grid-column:8/13}
  .trio>.ph:nth-child(3){grid-column:8/12}
  .duo>.ph:nth-child(1){grid-column:2/7}
  .duo>.ph:nth-child(2){grid-column:8/13;margin-top:22%}
  .duo.flip>.ph:nth-child(1){grid-column:1/6;margin-top:22%}
  .duo.flip>.ph:nth-child(2){grid-column:7/12;margin-top:0}
  .lead>.ph{grid-column:1/9}
  .lead>.note{grid-column:9/13;align-self:end;padding-bottom:1.6em}
  .lead.flip>.ph{grid-column:5/13;grid-row:1}
  .lead.flip>.note{grid-column:1/5;grid-row:1}
  .strip>.ph,.strip.odd>.ph:first-child{grid-column:span var(--span)}
}

/* digitals: the contact sheet */
.digitals{background:var(--band);color:var(--band-ink);padding-block:clamp(44px,7vw,110px);margin-top:clamp(36px,6vw,96px)}
.band-h{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:12px 28px;padding-bottom:clamp(20px,3vw,40px)}
.band-t{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(84px,20vw,300px);line-height:.8}
.band-h .lab{color:var(--band-mute);max-width:26em}
.sheet{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--gap) clamp(8px,1.4vw,20px)}
@media (min-width:860px){.sheet{grid-template-columns:repeat(4,1fr)}}
.digitals .ph-b{background:var(--band-rule)}
.digitals .ph figcaption{color:var(--band-mute)}
.digitals .ph figcaption .n{color:var(--band-ink)}

/* measurements: the comp card */
.stats{padding-block:clamp(44px,7vw,110px)}
.grid-s{display:grid;grid-template-columns:repeat(2,1fr);margin-top:clamp(22px,4vw,56px);border-top:1px solid var(--ink)}
.stat{padding:14px 0 18px;border-bottom:1px solid var(--rule);min-width:0}
.stat:nth-child(odd){padding-right:12px}
.stat:nth-child(even){padding-left:12px;border-left:1px solid var(--rule)}
.stat dt{color:var(--mute)}
.stat dd{display:flex;align-items:baseline;flex-wrap:wrap;gap:0 .5em}
.stat .v{font-family:var(--display);font-size:clamp(84px,17vw,210px);line-height:.92;font-variant-numeric:tabular-nums}
.stat .u{font-family:var(--serif);font-style:italic;font-size:clamp(18px,2vw,28px)}
.stat .alt{flex-basis:100%;color:var(--mute)}
.grid-s.odd .stat:first-child{grid-column:1/-1;padding-right:0}
.grid-s.odd .stat:nth-child(even){padding-left:0;padding-right:12px;border-left:0}
.grid-s.odd .stat:nth-child(odd):not(:first-child){padding-left:12px;padding-right:0;border-left:1px solid var(--rule)}
@media (min-width:860px){
  .grid-s,.grid-s.odd{grid-template-columns:repeat(var(--n),1fr)}
  .grid-s .stat,.grid-s.odd .stat:nth-child(n){grid-column:auto;padding:16px 16px 22px;border-left:1px solid var(--rule)}
  .grid-s .stat:first-child,.grid-s.odd .stat:first-child{padding-left:0;border-left:0}
  .stat .v{font-size:clamp(84px,calc(60vw / var(--n)),210px)}
}
.facts{display:grid;grid-template-columns:1fr;margin-top:clamp(20px,3vw,40px)}
.fact{display:grid;grid-template-columns:minmax(110px,11em) 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--rule)}
.fact dt{color:var(--mute)}
.fact dd{font-family:var(--serif);font-size:clamp(17px,1.5vw,21px);line-height:1.3}
@media (min-width:860px){.facts{grid-template-columns:1fr 1fr;column-gap:var(--gap)}}

/* contact */
.contact{border-top:1px solid var(--ink);padding-block:clamp(36px,6vw,90px) clamp(28px,4vw,56px)}
.c-rows{margin-top:clamp(20px,3vw,44px);border-top:1px solid var(--rule)}
.c-row{display:grid;grid-template-columns:1fr auto;gap:4px 12px;align-items:center;padding:14px 0;border-bottom:1px solid var(--rule)}
.c-row>.lab:first-child{grid-column:1/-1}
@media (min-width:860px){.c-row{grid-template-columns:11em 1fr auto;gap:12px}.c-row>.lab:first-child{grid-column:auto}}
.c-row .lab{color:var(--mute)}
.c-val{font-family:var(--serif);font-size:clamp(19px,2.6vw,34px);line-height:1.2;overflow-wrap:anywhere;min-width:0;user-select:all;-webkit-user-select:all}
.c-val a{text-decoration:none}
.c-val a:hover{color:var(--accent)}
.copy{border:1px solid var(--ink);background:none;padding:8px 14px;cursor:pointer}
.copy:hover{background:var(--ink);color:var(--paper)}
.colophon{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 24px;margin-top:clamp(28px,4vw,56px);color:var(--mute)}

/* viewer */
.lb{position:fixed;inset:0;width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:0;border:0;background:var(--band);color:var(--band-ink)}
.lb::backdrop{background:var(--band)}
.lb[open]{display:grid;grid-template-rows:auto 1fr auto}
.lb-bar,.lb-foot{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.lb-bar{padding-top:calc(12px + env(safe-area-inset-top,0px));padding-bottom:12px}
.lb-foot{padding-top:12px;padding-bottom:calc(14px + env(safe-area-inset-bottom,0px))}
.lb-view{min-height:0;display:flex;align-items:center;justify-content:center;touch-action:pan-y}
.lb-view img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block}
.lb button{border:1px solid var(--band-rule);background:none;color:var(--band-ink);padding:10px 16px;cursor:pointer}
.lb button:hover{border-color:var(--band-ink)}
.lb-cap{color:var(--band-mute);text-align:center;flex:1;min-width:0}
</style>

{% if preview %}<p class="preview lab">Layout preview with placeholder pictures and sample data</p>{% endif %}
<header class="top wrap lab">
  <span>{{ p.issue }}</span>
  <nav aria-label="Sections">
    {% for s in L.stories %}<a href="#{{ s.id }}">{{ s.title }}</a>{% endfor %}
    <a href="#digitals">Digitals</a><a href="#measurements">Measurements</a><a href="#contact">Contact</a>
  </nav>
  <span>{{ p.board }} · {{ p.base }}</span>
</header>

<section class="cover" aria-label="Cover">
  <div class="stage">
    <h1 class="mast" id="mast"><span>{{ p.name.first }}</span><span>{{ p.name.last }}</span></h1>
    <div class="cover-img">
      <img src="img/{{ L.cover.photo }}.jpg" srcset="img/{{ L.cover.photo }}-s.jpg 840w, img/{{ L.cover.photo }}.jpg 1700w" sizes="(min-width: 860px) 40vw, 90vw" alt="{{ full_name }}, cover portrait" style="object-position:{{ photos[L.cover.photo].pos }}" fetchpriority="high">
      <div class="mast" aria-hidden="true"><span>{{ p.name.first }}</span><span>{{ p.name.last }}</span></div>
      {% if L.cover.cutout %}<img class="cut" src="img/{{ L.cover.photo }}-cut.webp" alt="" aria-hidden="true" style="object-position:{{ photos[L.cover.photo].pos }}">{% endif %}
    </div>
    <p class="spine lab"><b>{{ p.issue }}</b><span>{{ p.board }}</span><span>{{ p.base }}</span>{% if p.stats.height_cm %}<span>{{ p.stats.height_cm }} cm</span>{% endif %}</p>
  </div>
</section>

<section class="intro wrap" aria-label="Profile">
  <p class="say">{{ p.statement }}</p>
  {% if L.intro and L.intro.photo %}{{ ph(L.intro.photo, '3/4', '(min-width: 860px) 24vw, 64vw') }}{% endif %}
  <p class="bio">{{ p.bio }}</p>
  <p class="quick lab">
    {% for s in stats %}<span><b>{{ s.label }}</b>{{ s.value }} {{ s.unit }}</span>{% endfor %}
    {% if p.hair %}<span><b>Hair</b>{{ p.hair }}</span>{% endif %}
    {% if p.eyes %}<span><b>Eyes</b>{{ p.eyes }}</span>{% endif %}
  </p>
</section>

{% for s in L.stories %}
<section class="story" id="{{ s.id }}">
  <div class="wrap">
    <header class="story-h">
      <span class="lab kick">{{ s.kicker }}</span>
      <h2 class="title">{{ s.title }}</h2>
      <p class="deck">{{ s.deck }}</p>
    </header>
  </div>
  {% for row in s.rows %}
  {% set flip = ' flip' if row.flip else '' %}
  {% if row.type == 'wide' %}
  <div class="bleed">{{ ph(row.photos[0], row.ratio or '16/9', '100vw') }}</div>
  {% elif row.type == 'trio' %}
  <div class="wrap"><div class="row trio">
    {{ ph(row.photos[0], '4/5', '(min-width: 860px) 58vw, 100vw') }}
    {{ ph(row.photos[1], '4/5', '(min-width: 860px) 40vw, 50vw') }}
    {{ ph(row.photos[2], '1/1', '(min-width: 860px) 32vw, 50vw') }}
  </div></div>
  {% elif row.type == 'duo' %}
  <div class="wrap"><div class="row duo{{ flip }}">
    {{ ph(row.photos[0], '2/3', '(min-width: 860px) 40vw, 75vw') }}
    {{ ph(row.photos[1], '4/5', '(min-width: 860px) 40vw, 75vw') }}
  </div></div>
  {% elif row.type == 'lead' %}
  <div class="wrap"><div class="row lead{{ flip }}">
    {{ ph(row.photos[0], row.ratio or ('3/2' if photos[row.photos[0]].ratio > 1.15 else '4/5'), '(min-width: 860px) 66vw, 100vw') }}
    <p class="note">{{ row.note or s.deck }}</p>
  </div></div>
  {% else %}
  <div class="wrap"><div class="row strip{{ ' odd' if row.photos|length is odd else '' }}" style="--span:{{ 12 // row.photos|length }}">
    {% for pid in row.photos %}{{ ph(pid, row.ratio or '3/4', '(min-width: 860px) 33vw, 50vw') }}{% endfor %}
  </div></div>
  {% endif %}
  {% endfor %}
</section>
{% endfor %}

{% if L.digitals and L.digitals.frames %}
<section class="digitals" id="digitals">
  <div class="wrap">
    <header class="band-h">
      <h2 class="band-t">Digitals</h2>
      <p class="lab">Unretouched. Natural light, no styling. Taken {{ L.digitals.date }}.</p>
    </header>
    <div class="sheet">
      {% for fr in L.digitals.frames %}
      {% set m = photos[fr.photo] %}
      <figure class="ph">
        <button class="ph-b" type="button" data-full="img/{{ fr.photo }}.jpg" data-n="{{ m.n|pad }}" data-cap="{{ fr.label }}" aria-label="Open digital {{ fr.label }}" style="aspect-ratio:3/4">
          <img src="img/{{ fr.photo }}-s.jpg" srcset="img/{{ fr.photo }}-s.jpg 840w, img/{{ fr.photo }}.jpg 1700w" sizes="(min-width: 860px) 24vw, 48vw" alt="{{ full_name }}, digital, {{ fr.label|lower }}" loading="lazy" decoding="async" style="object-position:{{ m.pos }}">
        </button>
        <figcaption class="lab"><span class="n">{{ m.n|pad }}</span><span>{{ fr.label }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="stats wrap" id="measurements">
  <header class="story-h">
    <span class="lab kick">Comp card</span>
    <h2 class="title">Measurements</h2>
    <p class="deck">Measured {{ L.digitals.date if L.digitals else p.issue }}.</p>
  </header>
  <dl class="grid-s{{ ' odd' if stats|length is odd else '' }}" style="--n:{{ stats|length }}">
    {% for s in stats %}
    <div class="stat"><dt class="lab">{{ s.label }}</dt><dd><span class="v">{{ s.value }}</span><span class="u">{{ s.unit }}</span>{% if s.alt %}<span class="alt lab">{{ s.alt }}</span>{% endif %}</dd></div>
    {% endfor %}
  </dl>
  <dl class="facts">
    {% for f in facts %}<div class="fact"><dt class="lab">{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}
  </dl>
</section>

<footer class="contact" id="contact">
  <div class="wrap">
    <span class="lab kick">{{ p.status }}</span>
    <h2 class="title">Bookings</h2>
    <div class="c-rows">
      {% if p.contact.email %}
      <div class="c-row"><span class="lab">E-mail</span><span class="c-val" id="mail">{{ p.contact.email }}</span><button class="copy lab" type="button" id="copy-mail" data-copy="{{ p.contact.email }}">Copy</button></div>
      {% endif %}
      {% if p.contact.instagram %}
      <div class="c-row"><span class="lab">Instagram</span><span class="c-val"><a href="https://www.instagram.com/{{ p.contact.instagram }}/" rel="noopener">@{{ p.contact.instagram }}</a></span><span></span></div>
      {% endif %}
      {% if p.contact.phone %}
      <div class="c-row"><span class="lab">Phone</span><span class="c-val">{{ p.contact.phone }}</span><span></span></div>
      {% endif %}
    </div>
    <p class="colophon lab"><span>{{ full_name }}</span><span>{{ p.issue }}</span><span>{{ total }} frames</span></p>
  </div>
</footer>

<dialog class="lb" id="lb" aria-label="Photo viewer">
  <div class="lb-bar lab"><span id="lb-count"></span><button type="button" id="lb-x" class="lab">Close</button></div>
  <div class="lb-view" id="lb-view"><img id="lb-img" alt=""></div>
  <div class="lb-foot lab"><button type="button" id="lb-p" class="lab" aria-label="Previous photo">Prev</button><span class="lb-cap" id="lb-cap"></span><button type="button" id="lb-n" class="lab" aria-label="Next photo">Next</button></div>
</dialog>

<script>
(function () {
  // Masthead: measure the real line widths once the display face is in, so the name fills its measure exactly.
  var stage = document.querySelector('.stage'), mast = document.getElementById('mast');
  function fit() {
    var fs = parseFloat(getComputedStyle(mast).fontSize), em = 0;
    mast.querySelectorAll('span').forEach(function (s) { em = Math.max(em, s.getBoundingClientRect().width / fs); });
    if (em > 0) stage.style.setProperty('--em', em.toFixed(4));
  }
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit); else fit();

  // In-page navigation without touching the address.
  document.querySelectorAll('.top nav a').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var t = document.getElementById(a.getAttribute('href').slice(1));
      if (t) { e.preventDefault(); t.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }
    });
  });

  // Copy the e-mail address; fall back to selecting it.
  var copy = document.getElementById('copy-mail');
  if (copy) copy.addEventListener('click', function () {
    var done = function () { copy.textContent = 'Copied'; setTimeout(function () { copy.textContent = 'Copy'; }, 1600); };
    var select = function () { var r = document.createRange(); r.selectNodeContents(document.getElementById('mail')); var s = getSelection(); s.removeAllRanges(); s.addRange(r); };
    try { navigator.clipboard.writeText(copy.dataset.copy).then(done, select); } catch (err) { select(); }
  });

  // Viewer.
  var items = Array.prototype.slice.call(document.querySelectorAll('.ph-b')), lb = document.getElementById('lb');
  var img = document.getElementById('lb-img'), cap = document.getElementById('lb-cap'), count = document.getElementById('lb-count'), at = 0;
  function show(i) {
    at = (i + items.length) % items.length;
    var b = items[at];
    img.src = b.dataset.full; img.alt = b.querySelector('img').alt;
    cap.textContent = b.dataset.cap || '';
    count.textContent = b.dataset.n + ' / ' + String(items.length).padStart(2, '0');
  }
  items.forEach(function (b, i) { b.addEventListener('click', function () { show(i); if (lb.showModal) lb.showModal(); else lb.setAttribute('open', ''); }); });
  function close() { if (lb.close) lb.close(); else lb.removeAttribute('open'); items[at].focus(); }
  document.getElementById('lb-x').addEventListener('click', close);
  document.getElementById('lb-p').addEventListener('click', function () { show(at - 1); });
  document.getElementById('lb-n').addEventListener('click', function () { show(at + 1); });
  lb.addEventListener('keydown', function (e) { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
  var x0 = null, view = document.getElementById('lb-view');
  view.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
  view.addEventListener('touchend', function (e) { if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; x0 = null; if (Math.abs(dx) > 48) show(at + (dx < 0 ? 1 : -1)); }, { passive: true });
})();
</script>
